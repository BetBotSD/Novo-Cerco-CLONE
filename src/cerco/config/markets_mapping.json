  "asian_handicap_ft": {
    "canonical_name": "Handicap Asiático (FT, 2 vias)",
    "kind": "two_way_handicap",
    "scope": "match",
    "filter": { "pinnacle_sport_ids": [1], "esnet_sport_ids": [102] },
    "arb": {
      "capable": true,
      "min_books": 2,
      "note": "Para cerco com ESporteNet, usar linhas 0 ou ±0.5 via crosswalk (2 vias e 3 vias)."
    },
    "pinnacle": {
      "source": "periods.num_0.spreads",
      "period": 0,
      "line_key": "points",
      "sides": {
        "home": ["home"],
        "away": ["away"]
      }
    },
    "esportenet": { "headers": [], "sides": {} },
    "esportenet_crosswalk": [
      {
        "when_line_abs_in": [0.5],
        "home_minus_0_5_vs_esnet": {
          "use_esnet_market": "moneyline_ft",
          "use_esnet_side": "home",
          "note": "Home -0.5 (tem que vencer) ≈ Moneyline Home da EsporteNet."
        },
        "away_minus_0_5_vs_esnet": {
          "use_esnet_market": "moneyline_ft",
          "use_esnet_side": "away",
          "note": "Away -0.5 (tem que vencer) ≈ Moneyline Away da EsporteNet."
        },
        "home_plus_0_5_vs_esnet": {
          "use_esnet_market": "double_chance_ft",
          "use_esnet_side": "home_or_draw",
          "note": "Home +0.5 (casa/empate) ≈ Dupla Chance 1X (home_or_draw) da EsporteNet."
        },
        "away_plus_0_5_vs_esnet": {
          "use_esnet_market": "double_chance_ft",
          "use_esnet_side": "draw_or_away",
          "note": "Away +0.5 (fora/empate) ≈ Dupla Chance X2 (draw_or_away) da EsporteNet."
        }
      },
    
      {
        "when_line_in": [0],
        "note": "Linha 0 equivale a DNB; usar draw_no_bet_ft para comparar (cerco 2 vias)."
      }
    ],
    "unsupported_lines": [0.25, 0.75, 1.25, 1.75, 2.25, 2.75]
  },

