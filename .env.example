# .env.example
# Arquivo de exemplo de variáveis de ambiente para o CERCO
# Copie este arquivo para .env e preencha os valores

# ============================================================================
# POSTGRESQL (OBRIGATÓRIO PARA MOBILE)
# ============================================================================
DATABASE_URL=postgresql://user:password@host:5432/cerco_db

# ============================================================================
# JWT AUTHENTICATION (OBRIGATÓRIO PARA MOBILE API)
# ============================================================================
JWT_SECRET_KEY=seu-secret-key-super-seguro-aqui-mude-em-producao

# ============================================================================
# EXPO PUSH NOTIFICATIONS (OPCIONAL)
# ============================================================================
# Token de acesso para maior rate limit na Expo Push API
# Se não fornecido, usará o serviço gratuito (com limites menores)
EXPO_ACCESS_TOKEN=seu-token-expo-aqui

# ============================================================================
# TELEGRAM (CANAL EXISTENTE - MANTER)
# ============================================================================
CERCO_TELEGRAM_BOT_TOKEN=seu-bot-token-aqui
CERCO_TELEGRAM_CHAT_ID=seu-chat-id-aqui
CERCO_TELEGRAM_WITH_IMAGE=true

# ============================================================================
# RAPIDAPI / PINNACLE (JÁ EXISTENTE)
# ============================================================================
RAPIDAPI_KEY=sua-chave-rapidapi
RAPIDAPI_HOST=pinnacle-odds.p.rapidapi.com

# ============================================================================
# CERCO CONFIG (JÁ EXISTENTE)
# ============================================================================
CERCO_TIME_WINDOW_HOURS=2.0
CERCO_POLL_EVERY_SEC=90
CERCO_STAKE_BASE_BRL=1000.0
CERCO_MIN_EDGE=0.0

# Timezone
APP_TZ=America/Bahia

# Log level
LOG_LEVEL=INFO
